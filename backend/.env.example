PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/pcs_db

# Required. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_secure_admin_token_here

# --- Optional (web dashboard) ---
# Signs session cookies. If unset, a random one is generated at startup (sessions end on restart).
# SESSION_SECRET=
# SESSION_TTL_HOURS=8
# Force the Secure cookie flag on/off (default: on when NODE_ENV=production).
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy so client IPs (rate limiting) are correct.
# TRUST_PROXY=true
# Python used to run the scanner (default: osint-scanner/.venv, then python3/python).
# PYTHON_BIN=
# Override the scanner folder (default: ../osint-scanner).
# SCANNER_DIR=
